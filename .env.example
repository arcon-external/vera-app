# Vera local development configuration. Copy to .env (gitignored).
#
# scripts/dev-api.sh starts veraserver with --local-development, which refuses a
# remote, multi-host, or unparseable Postgres target before opening the store.
# Only localhost, a loopback address, or a local Unix socket is accepted.
#
# The desktop reads ONLY VERA_API_URL from this file, and only in a `wails dev`
# build. Packaged and debug-packaged desktops ignore this file and every
# environment override: they always use the production API. The rest of this
# file is veraserver-owned and never enters the desktop process.
VERA_API_URL=http://127.0.0.1:8081

# Veraserver only. Keep the real password outside git and GitHub.
# In production this arrives from Secret Manager (vera-postgres-dsn).
VERA_POSTGRES_DSN=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional schema name. Defaults to vera.
VERA_POSTGRES_SCHEMA=vera

# Optional: the API listen address. Cloud Run uses the compiled default :8080;
# scripts/dev-api.sh forces 127.0.0.1:8081 for local development.
# VERA_API_ADDR=127.0.0.1:8081

# Veraserver only: Ed25519 private key (base64 or hex) used to sign every
# revision so printed documents can be verified. Generate once, store in
# Secret Manager (vera-signing-key), and never rotate alone: without it the
# service refuses to start, and losing it means no future document can be
# signed. Documents already issued keep verifying via their registered
# public key.
VERA_SIGNING_KEY=

# Optional: the public address printed into verification QR codes. Defaults
# to the Cloud Run service URL. Point it at a company domain when one is
# mapped; already-printed codes keep resolving because both hosts serve.
VERA_PUBLIC_BASE_URL=

# Optional: desktop updater release state. Set on the Cloud Run revision
# (they persist across image-only deploys); empty means "no update info"
# and the desktop never prompts on what it cannot name.
VERA_APP_LATEST=
VERA_APP_MIN_SUPPORTED=
VERA_APP_NOTES_URL=
VERA_APP_DOWNLOAD_WINDOWS=
VERA_APP_DOWNLOAD_WINDOWS_ARM64=
VERA_APP_DOWNLOAD_MACOS=
