# Vera desktop app: point at the API server. No database credentials here.
VERA_API_URL=http://100.93.103.83:8081

# Veraserver only. Keep the real password outside git and GitHub.
# In production this arrives from Secret Manager (vera-postgres-dsn).
VERA_POSTGRES_DSN=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional schema name. Defaults to vera.
VERA_POSTGRES_SCHEMA=vera

# Veraserver only: Ed25519 private key (base64 or hex) used to sign every
# revision so printed documents can be verified. Generate once, store in
# Secret Manager (vera-signing-key), and never rotate alone: without it the
# service refuses to start, and losing it means no future document can be
# signed. Documents already issued keep verifying via their registered
# public key.
VERA_SIGNING_KEY=

# Optional: the public address printed into verification QR codes. Defaults
# to the Cloud Run service URL. Point it at a company domain when one is
# mapped; already-printed codes keep resolving because both hosts serve.
VERA_PUBLIC_BASE_URL=
