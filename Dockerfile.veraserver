# Vera API server (veraserver).
FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /veraserver ./cmd/veraserver

FROM debian:bookworm-slim
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists
COPY --from=builder /veraserver /usr/local/bin/veraserver
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/veraserver"]
